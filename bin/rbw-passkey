#!/usr/bin/env python3
"""Perform one USB WebAuthn assertion; sensitive input and output use pipes."""

import ctypes
import json
import resource
import sys
import time

from fido2.client import DefaultClientDataCollector, Fido2Client, UserInteraction
from fido2.ctap2 import AssertionResponse, Ctap2
from fido2.ctap2.base import args
from fido2.hid import CtapHidDevice
from fido2.utils import websafe_encode


def get_assertion(
    self, rp_id, client_data_hash, allow_list=None, extensions=None, options=None,
    pin_uv_param=None, pin_uv_protocol=None, *, event=None, on_keepalive=None,
):
    """Like Ctap2.get_assertion, but accepts a response that omits the credential.

    CTAP allows that when the allow list names exactly one credential (WearAuthn
    does so), and python-fido2 would otherwise fail to parse the response.
    """
    response = self.send_cbor(
        Ctap2.CMD.GET_ASSERTION,
        args(rp_id, client_data_hash, allow_list, extensions, options,
             pin_uv_param, pin_uv_protocol),
        event=event,
        on_keepalive=on_keepalive,
    )
    if allow_list and len(allow_list) == 1:
        response = {1: allow_list[0], **response}
    return AssertionResponse.from_dict(response)


Ctap2.get_assertion = get_assertion


class OwnChannel:
    """Drops HID reports addressed to other CTAPHID channels.

    Every client of a hidraw device sees every report, and CTAPHID clients must
    ignore channels they don't own; python-fido2 instead fails with "Wrong
    channel" when another client or a late reply to an aborted request is
    active.
    """

    def __init__(self, device, connection):
        self.device = device
        self.connection = connection

    def read_packet(self):
        while True:
            packet = self.connection.read_packet()
            if int.from_bytes(packet[:4], "big") == self.device._channel_id:
                return packet

    def write_packet(self, packet):
        self.connection.write_packet(packet)

    def close(self):
        self.connection.close()


class HidDevice(CtapHidDevice):
    def __init__(self, descriptor, connection):
        self._channel_id = 0xFFFFFFFF
        super().__init__(descriptor, OwnChannel(self, connection))


class Interaction(UserInteraction):
    def __init__(self, pin):
        self.pin = pin
        self.prompted = False

    def request_pin(self, permissions, rp_id):
        pin, self.pin = self.pin, None
        return pin

    def prompt_up(self):
        self.prompted = True


def assert_passkey(request, devices):
    if len(devices) != 1:
        raise ValueError("Connect exactly one USB security key, then try again")
    options = request["options"]
    if options.get("userVerification") != "required":
        raise ValueError("User verification is required")
    interaction = Interaction(request.pop("pin"))
    client = Fido2Client(
        devices[0],
        DefaultClientDataCollector(request["origin"]),
        user_interaction=interaction,
    )
    started = time.monotonic()
    try:
        selection = client.get_assertion(options)
    except Exception as error:
        prompt = (
            "after asking for approval"
            if interaction.prompted
            else "without asking for approval"
        )
        raise RuntimeError(
            f"{type(error).__name__}: {error} ({prompt}, {time.monotonic() - started:.0f}s)"
        ) from None
    if len(selection.get_assertions()) != 1:
        raise ValueError("Multiple passkeys match; select a credential explicitly")
    response = selection.get_response(0)
    extensions = dict(response.client_extension_results)
    prf = extensions.get("prf", {}).get("results", {}).get("first")
    if not prf:
        raise ValueError("This security key did not return a PRF result")
    if isinstance(prf, bytes):
        prf = websafe_encode(prf)
    assertion = dict(response)
    assertion.pop("clientExtensionResults", None)
    assertion["extensions"] = {}
    return {"assertion": assertion, "prf": prf}


def pin_required(device):
    """Mirror Fido2Client: a PIN is used only without built-in UV."""
    options = Ctap2(device).info.options
    return bool(options.get("clientPin")) and not options.get("uv")


def probe_pin():
    devices = list(HidDevice.list_devices())
    try:
        required = len(devices) != 1 or pin_required(devices[0])
    finally:
        for device in devices:
            device.close()
    print("true" if required else "false")


def probe():
    devices = list(HidDevice.list_devices())
    for device in devices:
        device.close()
    print(len(devices))


def main():
    if sys.argv[1:] == ["--probe"]:
        probe()
        return
    if sys.argv[1:] == ["--probe-pin"]:
        probe_pin()
        return
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    if sys.platform.startswith("linux"):
        if ctypes.CDLL(None).prctl(4, 0, 0, 0, 0) != 0:
            raise RuntimeError("Cannot disable tracing for the passkey helper")
    raw = sys.stdin.buffer.read(131073)
    if len(raw) > 131072:
        raise ValueError("Passkey request is too large")
    request = json.loads(raw)
    del raw
    devices = list(HidDevice.list_devices())
    try:
        response = assert_passkey(request, devices)
        json.dump(response, sys.stdout)
        sys.stdout.write("\n")
    finally:
        for device in devices:
            device.close()


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"{type(error).__name__}: {error}", file=sys.stderr)
        raise SystemExit(1) from None
